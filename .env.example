# Vorlage: kopieren nach .env und Werte eintragen. Die .env wird NIE committet.

# --- Discord (Pflicht) ---
# Bot-Token aus https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Rechtsklick auf den Server -> "Server-ID kopieren" (Entwicklermodus nötig)
GUILD_ID=
# Rechtsklick auf deinen Namen -> "Benutzer-ID kopieren"
OWNER_ID=
# Optional: vorhandener Admin-Kanal. Leer lassen -> der Bot legt später selbst einen an.
ADMIN_CHANNEL_ID=

# --- Vinted ---
# User-Agent für Anfragen an Vinted. Leer lassen -> ehrlicher Bot-User-Agent
# (per M0-Probe am 15.10.2026 bestätigt, dass Vinted ihn akzeptiert).
VINTED_USER_AGENT=
# Standard-Abfrageintervall pro Filter in Sekunden (Minimum 5). Bei mehreren Filtern
# streckt der Bot es automatisch, damit das gemeinsame Budget reicht (siehe /status).
DEFAULT_INTERVAL_S=10
# Mindestabstand zwischen ZWEI BELIEBIGEN Vinted-Requests in Sekunden (über alle Filter).
# 3 = max. 20 Anfragen/min (empfohlen); 2 = max. 30/min (Turbo, Minimum).
# Nach 429/403 bremst der Bot selbst ab.
GLOBAL_MIN_SPACING_S=3

# Verkäufer nachschlagen für Flagge, Sterne und Avatar (1 Request pro neuem Verkäufer,
# 30 Tage gecacht). Bei gesetztem Länderfilter wird immer nachgeschlagen.
SELLER_LOOKUP=true
# Artikelseite laden für bis zu 3 Fotos + Beschreibung (1 Request pro gepostetem Artikel)
ITEM_DETAILS=true

# --- Start-Filter (M2; ab M3 legst du Filter per /filter add an) ---
# Vinted-Link aus der Adresszeile (vinted.at oder vinted.de)
SEED_FILTER_URL=
# Anzeigename im Footer
SEED_FILTER_NAME=start-filter
# Nur Verkäufer aus diesen Ländern, z. B. at,de,it,fr – leer = alle Länder
SEED_FILTER_COUNTRIES=
# Kanal-ID, in die gepostet wird (Rechtsklick auf Kanal -> "Kanal-ID kopieren")
SEED_CHANNEL_ID=

# --- Betrieb ---
DB_PATH=data/bot.db
LOG_DIR=logs
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
